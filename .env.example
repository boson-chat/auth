# Copy to .env for local development (make run / docker compose --profile app).
# Every variable and its default is documented in README.md.

ENV=development
PUBLIC_URL=http://localhost:8080
# APP_URL=http://localhost:3000        # web app hosting /verify-email and /reset-password
COOKIE_SECURE=false                    # plain http in dev only

DATABASE_URL=postgres://auth:auth-dev-password@localhost:5432/auth?sslmode=disable

# 32 random bytes, base64. Generate: go run ./cmd keys gen-kek
AUTH_KEY_ENCRYPTION_KEY=

# Shared secret for the internal API (IRC SASL bridge). Generate: openssl rand -hex 32
INTERNAL_API_TOKEN=
# Separate secret for the acting API (RoleServ changes roles as an IRC user);
# give it to RoleServ only. Empty disables it. Generate: openssl rand -hex 32
INTERNAL_ACTING_TOKEN=

# Defaults for the runtime network settings (admins change them with PATCH /v1/admin/settings).
REGISTRATION=open
REQUIRE_EMAIL_VERIFICATION=true
CHANNEL_CREATION=registered            # registered | admins
VOICE_CHANNEL_CREATION=founders        # admins | founders | registered
CHANNEL_AUTO_REGISTER=true             # IRC registers a new channel to the user who created it
CHANNEL_EXPIRY_DAYS=0                  # 0..3650 idle days before IRC unregisters a channel; 0 = never

# Public role lookups (GET /v1/roles, /v1/users/roles), per client IP.
# RATE_LIMIT_PUBLIC_BURST=60
# RATE_LIMIT_PUBLIC_PER_MINUTE=120

# Mailpit from docker-compose.yml (UI: http://localhost:8025). Empty SMTP_HOST = log links instead.
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_TLS=none
SMTP_FROM=boson <no-reply@localhost>

# SSO: providers are added at runtime (admin API, see docs/sso.md). Extra
# return_to targets for desktop/native clients (one-time code mode):
# SSO_RETURN_TO_ALLOWED=http://127.0.0.1:*,http://[::1]:*,boson://
